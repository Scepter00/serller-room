generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  REPLY
  MENTION
  TIP
}

enum ModerationStatus {
  ACTIVE
  SUSPENDED
}

enum PostStatus {
  ACTIVE
  REMOVED
}

enum ReportTargetType {
  USER
  POST
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum BlockchainEventType {
  PAYMENT
  CONTRACT_EVENT
}

model User {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  createdAt     DateTime @default(now())

  profile    Profile?
  media      Media[]
  challenges AuthChallenge[]
}

model Profile {
  id               String           @id @default(cuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  username         String?          @unique
  displayName      String?
  bio              String?
  avatarCid        String?
  avatarUrl        String?
  moderationStatus ModerationStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  posts               Post[]           @relation("Author")
  comments            Comment[]
  likes               Like[]
  followers           Follow[]         @relation("Following")
  following           Follow[]         @relation("Follower")
  notificationsReceived Notification[] @relation("Recipient")
  notificationsSent    Notification[] @relation("Actor")
  blocksCreated        Block[]        @relation("Blocker")
  blocksReceived       Block[]        @relation("Blocked")
  mutesCreated         Mute[]         @relation("Muter")
  mutesReceived        Mute[]         @relation("Muted")
  reportsMade          Report[]

  @@index([username])
}

model Post {
  id           String     @id @default(cuid())
  authorId     String
  author       Profile    @relation("Author", fields: [authorId], references: [id], onDelete: Cascade)
  text         String?
  link         String?
  mediaCid     String?
  contentHash  String?
  notarized    Boolean    @default(false)
  notaryTxHash String?
  status       PostStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  comments Comment[]
  likes    Like[]
  hashtags PostHashtag[]

  @@index([authorId, createdAt])
  @@index([createdAt])
}

model PostHashtag {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    String

  @@unique([postId, tag])
  @@index([tag])
}

model Comment {
  id        String     @id @default(cuid())
  postId    String
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    Profile    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  text      String
  status    PostStatus @default(ACTIVE)
  createdAt DateTime   @default(now())

  @@index([postId])
  @@index([authorId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    Profile  @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   Profile  @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   Profile          @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       Profile?         @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)
  type        NotificationType
  postId      String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
}

model Media {
  id           String   @id @default(cuid())
  uploaderId   String
  uploader     User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  cid          String   @unique
  mimeType     String
  sizeBytes    Int
  originalName String?
  createdAt    DateTime @default(now())
}

model Transaction {
  id        String            @id @default(cuid())
  txHash    String?           @unique
  buildId   String            @unique
  fromAddress String
  toAddress   String
  amount      String
  asset       String            @default("XLM")
  postId      String?
  memo        String?
  status      TransactionStatus @default(PENDING)
  ledger      Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([fromAddress])
  @@index([toAddress])
  @@index([postId])
}

model Report {
  id         String           @id @default(cuid())
  reporterId String
  reporter   Profile          @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType ReportTargetType
  targetId   String
  reason     String
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now())

  @@index([status])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   Profile  @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   Profile  @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Mute {
  id        String   @id @default(cuid())
  muterId   String
  muter     Profile  @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)
  mutedId   String
  muted     Profile  @relation("Muted", fields: [mutedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([muterId, mutedId])
}

model AuthChallenge {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey String
  nonce     String   @unique
  message   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([publicKey, used])
}

model BlockchainEvent {
  id          String              @id @default(cuid())
  txHash      String
  opIndex     Int
  type        BlockchainEventType
  data        String
  processedAt DateTime            @default(now())

  @@unique([txHash, opIndex])
  @@index([txHash])
}

model IndexerCheckpoint {
  id        Int      @id @default(1)
  cursor    String
  updatedAt DateTime @updatedAt
}
