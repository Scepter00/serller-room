# ─────────────────────────────────────────────────────────────
# Serller environment configuration
# Copy to `.env` (see `npm run setup` — it generates a local dev .env)
# NEVER commit real secrets. Rule 3: no private keys anywhere.
# ─────────────────────────────────────────────────────────────

# ── Stellar network ───────────────────────────────────────────
# testnet (default) | mainnet (locked behind env; only after security review)
STELLAR_NETWORK=testnet
STELLAR_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# ── Auth / sessions ───────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change-me-generate-a-long-random-string
SESSION_TTL_DAYS=7

# ── Database ──────────────────────────────────────────────────
# Local dev / CI uses prisma/schema.prisma (SQLite):
DATABASE_URL=file:./dev.db
#
# Production uses prisma/schema.postgres.prisma (PostgreSQL):
# DATABASE_URL=postgres://serller:serller@localhost:5432/serller
# Run `npm run db:sync:prod` after model changes to regenerate the schema.

# ── Media storage ─────────────────────────────────────────────
# driver: pinata (production) | local (DEV MOCK — files under public/uploads)
STORAGE_DRIVER=pinata
PINATA_JWT=
PINATA_GATEWAY_URL=
IPFS_PUBLIC_GATEWAY=https://ipfs.io

# ── Soroban notary contract (Phase 9) ─────────────────────────
NOTARY_CONTRACT_ID=

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_NETWORK=testnet
